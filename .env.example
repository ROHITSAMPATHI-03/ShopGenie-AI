# ShopGenie AI Environment Configuration
# Copy this file to .env and configure the variables

# Gemini API Credentials (Required for AI shopping assistant, fallback used if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# PayPal Sandbox Credentials (Required for sandbox payments, test mode enabled if omitted)
# Public Client ID is also safely accessible to the frontend
PAYPAL_CLIENT_ID=
# Client secret must remain backend-only
PAYPAL_CLIENT_SECRET=
# PayPal Webhook ID (from PayPal Developer Dashboard > Webhooks)
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Currency & Conversion Configuration
# All catalogue prices are in INR paise. PayPal charges strictly in Sandbox USD.
CHARGE_CURRENCY=USD
# Fixed illustrative demo conversion rate (1 INR = 0.012 USD)
INR_TO_USD=0.012

# Server & Session Configuration
FRONTEND_ORIGIN=http://localhost:5173
# Cryptographically random secret of at least 32 characters (Required in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left blank in development/test, a secure 32-byte secret is generated automatically at startup.
SESSION_SECRET=
DATABASE_PATH=./data/shopgenie.db
PORT=4000

